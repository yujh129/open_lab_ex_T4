{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopPet",
  "version": "0.1.0",
  "identifier": "com.example.desktop-pet",
  "build": {
    "frontendDist": "../../../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
          {
            "label": "main",
            "width": 320,
            "height": 420,
            "transparent": true,
            "decorations": false,
            "alwaysOnTop": true,
            "skipTaskbar": true,
            "resizable": false,
            "focus": true,
            "shadow": false
          }
        ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
