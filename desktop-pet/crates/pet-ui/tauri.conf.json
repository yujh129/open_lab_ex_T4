{
  "productName": "DesktopPet",
  "version": "0.1.0",
  "identifier": "com.example.desktop-pet",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
